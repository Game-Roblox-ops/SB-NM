local bossNames = {
    "GojoBoss",
    "JinwooBoss", 
    "MadokaBoss",
    "SukunaBoss",
    "YujiBoss",
    "AizenBoss"
}

local selectedBoss = bossNames[1]
local autoGotoEnabled = false

-- Boss UI Frame
local bossFrame = Instance.new("Frame")
bossFrame.Size = UDim2.new(0, 200, 0, 240)
bossFrame.Position = UDim2.new(0, 20, 0.5, 60)
bossFrame.BackgroundColor3 = Color3.fromRGB(15, 15, 20)
bossFrame.BorderSizePixel = 0
bossFrame.Active = true
bossFrame.Draggable = true
bossFrame.Parent = ScreenGui

local bossFrameCorner = Instance.new("UICorner")
bossFrameCorner.CornerRadius = UDim.new(0, 12)
bossFrameCorner.Parent = bossFrame

local bossStroke = Instance.new("UIStroke")
bossStroke.Color = Color3.fromRGB(60, 60, 80)
bossStroke.Thickness = 1.5
bossStroke.Parent = bossFrame

local bossTitle = Instance.new("TextLabel")
bossTitle.Size = UDim2.new(1, 0, 0, 30)
bossTitle.Position = UDim2.new(0, 0, 0, 8)
bossTitle.BackgroundTransparency = 1
bossTitle.Text = "⚔ AUTO BOSS"
bossTitle.TextColor3 = Color3.fromRGB(220, 220, 255)
bossTitle.TextSize = 14
bossTitle.Font = Enum.Font.GothamBold
bossTitle.Parent = bossFrame

local selectedLabel = Instance.new("TextLabel")
selectedLabel.Size = UDim2.new(1, 0, 0, 20)
selectedLabel.Position = UDim2.new(0, 0, 0, 38)
selectedLabel.BackgroundTransparency = 1
selectedLabel.Text = "Boss: " .. selectedBoss
selectedLabel.TextColor3 = Color3.fromRGB(180, 180, 255)
selectedLabel.TextSize = 11
selectedLabel.Font = Enum.Font.Gotham
selectedLabel.Parent = bossFrame

-- Boss buttons
local bossListFrame = Instance.new("Frame")
bossListFrame.Size = UDim2.new(1, -10, 0, 150)
bossListFrame.Position = UDim2.new(0, 5, 0, 60)
bossListFrame.BackgroundTransparency = 1
bossListFrame.Parent = bossFrame

local bossListLayout = Instance.new("UIListLayout")
bossListLayout.Padding = UDim.new(0, 3)
bossListLayout.Parent = bossListFrame

for _, name in ipairs(bossNames) do
    local bossBtn = Instance.new("TextButton")
    bossBtn.Size = UDim2.new(1, 0, 0, 22)
    bossBtn.BackgroundColor3 = Color3.fromRGB(40, 40, 60)
    bossBtn.Text = name
    bossBtn.TextColor3 = Color3.fromRGB(200, 200, 200)
    bossBtn.TextSize = 11
    bossBtn.Font = Enum.Font.Gotham
    bossBtn.BorderSizePixel = 0
    bossBtn.Parent = bossListFrame

    local btnCorner = Instance.new("UICorner")
    btnCorner.CornerRadius = UDim.new(0, 6)
    btnCorner.Parent = bossBtn

    bossBtn.MouseButton1Click:Connect(function()
        selectedBoss = name
        selectedLabel.Text = "Boss: " .. selectedBoss
        bossBtn.BackgroundColor3 = Color3.fromRGB(70, 130, 220)
        for _, b in ipairs(bossListFrame:GetChildren()) do
            if b:IsA("TextButton") and b ~= bossBtn then
                b.BackgroundColor3 = Color3.fromRGB(40, 40, 60)
            end
        end
    end)
end

-- Toggle button
local gotoToggleBtn = Instance.new("TextButton")
gotoToggleBtn.Size = UDim2.new(0, 140, 0, 24)
gotoToggleBtn.Position = UDim2.new(0.5, -70, 1, -30)
gotoToggleBtn.BackgroundColor3 = Color3.fromRGB(80, 80, 200)
gotoToggleBtn.Text = "ENABLE"
gotoToggleBtn.TextColor3 = Color3.fromRGB(255, 255, 255)
gotoToggleBtn.TextSize = 13
gotoToggleBtn.Font = Enum.Font.GothamBold
gotoToggleBtn.BorderSizePixel = 0
gotoToggleBtn.Parent = bossFrame

local gotoCorner = Instance.new("UICorner")
gotoCorner.CornerRadius = UDim.new(0, 8)
gotoCorner.Parent = gotoToggleBtn

gotoToggleBtn.MouseButton1Click:Connect(function()
    autoGotoEnabled = not autoGotoEnabled
    if autoGotoEnabled then
        gotoToggleBtn.Text = "DISABLE"
        gotoToggleBtn.BackgroundColor3 = Color3.fromRGB(200, 60, 60)
        bossStroke.Color = Color3.fromRGB(80, 220, 120)
    else
        gotoToggleBtn.Text = "ENABLE"
        gotoToggleBtn.BackgroundColor3 = Color3.fromRGB(80, 80, 200)
        bossStroke.Color = Color3.fromRGB(60, 60, 80)
    end
end)

-- Auto goto boss loop
task.spawn(function()
    while true do
        task.wait()
        if autoGotoEnabled then
            pcall(function()
                for _, v in pairs(workspace.NPCs:GetChildren()) do
                    if v.Name == selectedBoss then
                        local hrp = v:FindFirstChild("HumanoidRootPart")
                        if hrp then
                            player.Character.HumanoidRootPart.CFrame = hrp.CFrame * CFrame.new(0, 0, 5)
                        end
                    end
                end
            end)
        end
    end
end)