local function createTarget(index)
    local t = Instance.new("ImageButton")
    t.Size = UDim2.new(0, 40, 0, 40)
    t.Position = UDim2.new(0.5, -20 + (index * 50), 0.5, -20)
    t.BackgroundTransparency = 1
    t.Image = "rbxassetid://7072718362"
    t.ZIndex = 200
    t.Active = true
    t.Draggable = true
    t.Parent = screenGui

    local label = Instance.new("TextLabel")
    label.Size = UDim2.new(1, 0, 0, 15)
    label.Position = UDim2.new(0, 0, 1, 2)
    label.BackgroundTransparency = 1
    label.Text = "#" .. index
    label.TextColor3 = Color3.fromRGB(255, 255, 100)
    label.TextSize = 11
    label.Font = Enum.Font.GothamBold
    label.ZIndex = 201
    label.Parent = t

    return t
end

-- Fixed time-based clicking loop
local function startClickingTarget(t)
    return task.spawn(function()
        local lastClick = 0
        while clicking do
            local cps = tonumber(speedBox.Text) or 20
            cps = math.clamp(cps, 0.001, 10000)
            local interval = 1 / cps
            local now = tick()
            if now - lastClick >= interval then
                lastClick = now
                local pos = t.AbsolutePosition + (t.AbsoluteSize / 2)
                local x = math.floor(pos.X)
                local y = math.floor(pos.Y)
                VirtualInputManager:SendMouseButtonEvent(x, y, 0, true, game, 0)
                VirtualInputManager:SendMouseButtonEvent(x, y, 0, false, game, 0)
            end
            task.wait()
        end
    end)
end

local function stopAllThreads()
    clicking = false
    for _, thread in ipairs(clickThreads) do
        task.cancel(thread)
    end
    clickThreads = {}
end

local function startAllThreads()
    clicking = true
    for _, t in ipairs(targets) do
        table.insert(clickThreads, startClickingTarget(t))
    end
end

table.insert(targets, createTarget(1))

addBtn.MouseButton1Click:Connect(function()
    if #targets >= 10 then return end
    table.insert(targets, createTarget(#targets + 1))
    targetCountLabel.Text = "Targets: " .. #targets
    if clicking then
        table.insert(clickThreads, startClickingTarget(targets[#targets]))
    end
end)

removeBtn.MouseButton1Click:Connect(function()
    if #targets <= 1 then return end
    local last = table.remove(targets)
    last:Destroy()
    targetCountLabel.Text = "Targets: " .. #targets
    if clicking then
        stopAllThreads()
        startAllThreads()
    end
end)

toggleButton.MouseButton1Click:Connect(function()
    if clicking then
        stopAllThreads()
        toggleButton.Text = "ENABLE"
        statusLabel.Text = "Status: OFF"
        statusLabel.TextColor3 = Color3.fromRGB(180, 80, 80)
        TweenService:Create(toggleButton, TweenInfo.new(0.2), {BackgroundColor3 = Color3.fromRGB(80, 80, 200)}):Play()
        TweenService:Create(stroke, TweenInfo.new(0.2), {Color = Color3.fromRGB(60, 60, 80)}):Play()
    else
        startAllThreads()
        toggleButton.Text = "DISABLE"
        statusLabel.Text = "Status: ON"
        statusLabel.TextColor3 = Color3.fromRGB(80, 220, 120)
        TweenService:Create(toggleButton, TweenInfo.new(0.2), {BackgroundColor3 = Color3.fromRGB(200, 60, 60)}):Play()
        TweenService:Create(stroke, TweenInfo.new(0.2), {Color = Color3.fromRGB(80, 220, 120)}):Play()
    end
end)

