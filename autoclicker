-- ========== AUTO CLICK LOGIC ==========
local clicking = false
local clickThread

local function getCPS()
	local n = tonumber(speedBox.Text)
	if not n or n < 1 then
		return 1
	end
	if n > 1000 then
		return 1000 -- cap it so it doesn't freeze you
	end
	return n
end

local function startClicking()
	if clickThread then return end
	clickThread = task.spawn(function()
		while clicking do
			local cps = getCPS()
			local delayTime = 1 / cps

			-- Get target screen position
			local pos = target.AbsolutePosition + (target.AbsoluteSize / 2)
			local x = math.floor(pos.X)
			local y = math.floor(pos.Y)

			-- Send mouse click at that position
			VirtualInputManager:SendMouseButtonEvent(x, y, 0, true, game, 0)
			VirtualInputManager:SendMouseButtonEvent(x, y, 0, false, game, 0)

			task.wait(delayTime)
		end
	end)
end

local function stopClicking()
	clicking = false
	clickThread = nil
end

toggleButton.MouseButton1Click:Connect(function()
	clicking = not clicking
	if clicking then
		toggleButton.Text = "Auto Click: ON"
		toggleButton.BackgroundColor3 = Color3.fromRGB(0, 200, 100)
		startClicking()
	else
		toggleButton.Text = "Auto Click: OFF"
		toggleButton.BackgroundColor3 = Color3.fromRGB(20, 20, 20)
		stopClicking()
	end
end)