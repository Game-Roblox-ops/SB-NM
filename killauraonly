toggleBtn.MouseButton1Click:Connect(function()
    auraEnabled = not auraEnabled
    if auraEnabled then
        toggleBtn.Text = "DISABLE"
        statusLabel.Text = "Status: ON"
        statusLabel.TextColor3 = Color3.fromRGB(80, 220, 120)
        TweenService:Create(toggleBtn, TweenInfo.new(0.2), {BackgroundColor3 = Color3.fromRGB(200, 60, 60)}):Play()
        TweenService:Create(stroke, TweenInfo.new(0.2), {Color = Color3.fromRGB(80, 220, 120)}):Play()
    else
        toggleBtn.Text = "ENABLE"
        statusLabel.Text = "Status: OFF"
        statusLabel.TextColor3 = Color3.fromRGB(180, 80, 80)
        TweenService:Create(toggleBtn, TweenInfo.new(0.2), {BackgroundColor3 = Color3.fromRGB(80, 80, 200)}):Play()
        TweenService:Create(stroke, TweenInfo.new(0.2), {Color = Color3.fromRGB(60, 60, 80)}):Play()
    end
end)

RunService.Stepped:Connect(function()
    if not auraEnabled then return end
    local hrp = player.Character and player.Character:FindFirstChild("HumanoidRootPart")
    if not hrp then return end

    auraRadius = tonumber(radiusBox.Text) or 13

    local nearby = workspace:GetPartBoundsInRadius(hrp.Position, auraRadius)
    for _, part in pairs(nearby) do
        local model = part:FindFirstAncestorOfClass("Model")
        if model and model ~= player.Character then
            local humanoid = model:FindFirstChildOfClass("Humanoid")
            local npcHRP = model:FindFirstChild("HumanoidRootPart")
            if humanoid and npcHRP and not Players:GetPlayerFromCharacter(model) then
                pcall(function()
                    humanoid:ChangeState(Enum.HumanoidStateType.Dead)
                end)
            end
        end
    end
end)

print("Kill Aura loaded!")