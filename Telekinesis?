-- Mobile Telekinesis UI
local Players = game:GetService("Players")
local player = Players.LocalPlayer
local mouse = player:GetMouse()

local screenGui = Instance.new("ScreenGui")
screenGui.Name = "TelekinesisUI"
screenGui.ResetOnSpawn = false
screenGui.Parent = game:GetService("CoreGui")

-- Main frame
local frame = Instance.new("Frame")
frame.Size = UDim2.new(0, 220, 0, 180)
frame.Position = UDim2.new(0, 10, 0.5, -90)
frame.BackgroundColor3 = Color3.fromRGB(25, 25, 25)
frame.BorderSizePixel = 0
frame.Active = true
frame.Parent = screenGui

local corner = Instance.new("UICorner")
corner.CornerRadius = UDim.new(0, 10)
corner.Parent = frame

-- Title
local title = Instance.new("TextLabel")
title.Size = UDim2.new(1, 0, 0, 30)
title.BackgroundTransparency = 1
title.Text = "🌀 Telekinesis"
title.TextColor3 = Color3.fromRGB(255, 255, 255)
title.TextSize = 13
title.Font = Enum.Font.GothamBold
title.Parent = frame

-- Drag
local dragging, dragStart, startPos = false, nil, nil
frame.InputBegan:Connect(function(input)
    if input.UserInputType == Enum.UserInputType.Touch or input.UserInputType == Enum.UserInputType.MouseButton1 then
        dragging = true
        dragStart = input.Position
        startPos = frame.Position
    end
end)
frame.InputChanged:Connect(function(input)
    if dragging and (input.UserInputType == Enum.UserInputType.Touch or input.UserInputType == Enum.UserInputType.MouseMovement) then
        local delta = input.Position - dragStart
        frame.Position = UDim2.new(startPos.X.Scale, startPos.X.Offset + delta.X, startPos.Y.Scale, startPos.Y.Offset + delta.Y)
    end
end)
frame.InputEnded:Connect(function(input)
    if input.UserInputType == Enum.UserInputType.Touch or input.UserInputType == Enum.UserInputType.MouseButton1 then
        dragging = false
    end
end)

local function makeBtn(text, color, pos, size)
    local btn = Instance.new("TextButton")
    btn.Size = size or UDim2.new(0, 60, 0, 30)
    btn.Position = pos
    btn.BackgroundColor3 = color
    btn.TextColor3 = Color3.fromRGB(255, 255, 255)
    btn.Text = text
    btn.TextSize = 11
    btn.Font = Enum.Font.GothamBold
    btn.BorderSizePixel = 0
    btn.Parent = frame
    local c = Instance.new("UICorner")
    c.CornerRadius = UDim.new(0, 6)
    c.Parent = btn
    return btn
end

-- Buttons
local grabBtn  = makeBtn("✋ Grab",   Color3.fromRGB(70,130,220),  UDim2.new(0,8,0,38),   UDim2.new(0,100,0,30))
local dropBtn  = makeBtn("🖐 Drop",   Color3.fromRGB(180,80,80),   UDim2.new(0,114,0,38), UDim2.new(0,100,0,30))
local closeBtn = makeBtn("Q -10",     Color3.fromRGB(80,80,80),    UDim2.new(0,8,0,76),   UDim2.new(0,60,0,28))
local farBtn   = makeBtn("E +10",     Color3.fromRGB(80,80,80),    UDim2.new(0,76,0,76),  UDim2.new(0,60,0,28))
local snap10   = makeBtn("T: 10",     Color3.fromRGB(60,60,60),    UDim2.new(0,144,0,76), UDim2.new(0,60,0,28))
local resetBtn = makeBtn("R Reset",   Color3.fromRGB(150,100,50),  UDim2.new(0,8,0,112),  UDim2.new(0,90,0,28))
local snap200  = makeBtn("Y: 200",    Color3.fromRGB(60,60,60),    UDim2.new(0,106,0,112),UDim2.new(0,60,0,28))
local netBtn   = makeBtn("K Net",     Color3.fromRGB(100,50,150),  UDim2.new(0,8,0,148),  UDim2.new(0,196,0,28))

-- Telekinesis logic
local BP = Instance.new("BodyPosition")
BP.maxForce = Vector3.new(math.huge, math.huge, math.huge)
BP.P = BP.P * 1.1

local object = nil
local mousedown = false
local dist = 50

grabBtn.MouseButton1Click:Connect(function()
    if mousedown then return end
    mousedown = true
    local target = mouse.Target
    if target and not target.Anchored then
        object = target
        dist = (object.Position - player.Character.HumanoidRootPart.Position).Magnitude
        BP.Parent = object
        -- Keep updating position
        task.spawn(function()
            while mousedown and object and object.Parent do
                local hrp = player.Character and player.Character:FindFirstChild("HumanoidRootPart")
                if hrp then
                    local w = CFrame.new(hrp.Position, mouse.Hit.p)
                    BP.position = hrp.Position + w.LookVector * dist
                end
                task.wait()
            end
        end)
    end
end)

dropBtn.MouseButton1Click:Connect(function()
    mousedown = false
    if object then
        BP.Parent = nil
        object = nil
    end
end)

closeBtn.MouseButton1Click:Connect(function()
    if dist >= 15 then dist = dist - 10 end
end)

farBtn.MouseButton1Click:Connect(function()
    dist = dist + 10
end)

snap10.MouseButton1Click:Connect(function()
    dist = 10
end)

snap200.MouseButton1Click:Connect(function()
    dist = 200
end)

resetBtn.MouseButton1Click:Connect(function()
    if object then
        local BG = Instance.new("BodyGyro")
        BG.maxTorque = Vector3.new(math.huge, math.huge, math.huge)
        BG.CFrame = CFrame.new(object.CFrame.p)
        BG.Parent = object
        task.wait(0.5)
        BG:Destroy()
        object.Velocity = Vector3.new(0,0,0)
        object.RotVelocity = Vector3.new(0,0,0)
    end
end)

local netEnabled = false
local netConnection = nil
netBtn.MouseButton1Click:Connect(function()
    netEnabled = not netEnabled
    if netEnabled then
        netBtn.BackgroundColor3 = Color3.fromRGB(80, 200, 120)
        netBtn.Text = "K Net ON"
        netConnection = game:GetService("RunService").RenderStepped:Connect(function()
            pcall(function()
                local h = sethiddenproperty or set_hidden_property
                if h then
                    h(player, "SimulationRadius", math.huge)
                    h(player, "MaxSimulationRadius", math.huge)
                end
            end)
        end)
    else
        netBtn.BackgroundColor3 = Color3.fromRGB(100, 50, 150)
        netBtn.Text = "K Net"
        if netConnection then
            netConnection:Disconnect()
            netConnection = nil
        end
    end
end)
