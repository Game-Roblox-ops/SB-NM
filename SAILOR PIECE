local m1Enabled = false

local function updateUI()
    if autoEnabled then
        StatusLabel.Text = "Skill: ON"
        StatusLabel.TextColor3 = Color3.fromRGB(80, 220, 120)
        Button.Text = "SKILL: ON"
        TweenService:Create(Button, TweenInfo.new(0.2), {BackgroundColor3 = Color3.fromRGB(200, 60, 60)}):Play()
        TweenService:Create(Stroke, TweenInfo.new(0.2), {Color = Color3.fromRGB(80, 220, 120)}):Play()
    else
        StatusLabel.Text = "Skill: OFF"
        StatusLabel.TextColor3 = Color3.fromRGB(180, 80, 80)
        Button.Text = "SKILL: OFF"
        TweenService:Create(Button, TweenInfo.new(0.2), {BackgroundColor3 = Color3.fromRGB(80, 80, 200)}):Play()
        TweenService:Create(Stroke, TweenInfo.new(0.2), {Color = Color3.fromRGB(60, 60, 80)}):Play()
    end
end

Button.MouseButton1Click:Connect(function()
    autoEnabled = not autoEnabled
    updateUI()
end)

