local function fireAllSkills()
    AbilityRemote:FireServer(5)
    task.wait(delay)
    AbilityRemote:FireServer()
    task.wait(delay)
    AbilityRemote:FireServer(3)
    task.wait(delay)
    AbilityRemote:FireServer(4)
    task.wait(delay)
    FruitRemote:FireServer("UseAbility", {FruitPower = "Quake", KeyCode = Enum.KeyCode.Z})
    task.wait(delay)
    FruitRemote:FireServer("UseAbility", {FruitPower = "Quake", KeyCode = Enum.KeyCode.X})
    task.wait(delay)
    FruitRemote:FireServer("UseAbility", {FruitPower = "Quake", KeyCode = Enum.KeyCode.C})
    task.wait(delay)
end

task.spawn(function()
    while true do
        if autoEnabled then
            fireAllSkills()
            task.wait(loopDelay)
        else
            task.wait(0.1)
        end
    end
end)

