if game.PlaceId ~= 79305036070450 then return end

local Players = game:GetService("Players")
local player = Players.LocalPlayer
local playerGui = player.PlayerGui
local ReplicatedStorage = game:GetService("ReplicatedStorage")
local TweenService = game:GetService("TweenService")
local buyEvent = ReplicatedStorage:WaitForChild("Events"):WaitForChild("buy")

local DELAY = 0.5
local AMOUNT = 1
local diceEnabled = false

local diceList = {
    "Uriel Dice",
    "Matrix Dice",
    "Yinyang Dice",
    "Chronos Dice",
    "Limbo Dice",
    "Impossible Dice",
    "Disaster Dice",
    "Annihilation Dice",
    "Emperor Dice",
    "Eldritch Dice",
    "Galactic Dice",
    "Seraphic Dice",
    "Kraken Dice",
    "Reality Dice",
}

local potionList = {
    "No Consume Dice Potion 1",
    "Money Potion 3",
}

-- UI
local ScreenGui = Instance.new("ScreenGui")
ScreenGui.Name = "SpinUI"
ScreenGui.ResetOnSpawn = false
ScreenGui.Parent = playerGui

local Frame = Instance.new("Frame")
Frame.Size = UDim2.new(0, 200, 0, 90)
Frame.Position = UDim2.new(0, 20, 0.5, -45)
Frame.BackgroundColor3 = Color3.fromRGB(15, 15, 20)
Frame.BorderSizePixel = 0
Frame.Active = true
Frame.Draggable = true
Frame.Parent = ScreenGui

local Corner = Instance.new("UICorner")
Corner.CornerRadius = UDim.new(0, 12)
Corner.Parent = Frame

local Stroke = Instance.new("UIStroke")
Stroke.Color = Color3.fromRGB(60, 60, 80)
Stroke.Thickness = 1.5
Stroke.Parent = Frame

local Title = Instance.new("TextLabel")
Title.Size = UDim2.new(1, 0, 0, 30)
Title.Position = UDim2.new(0, 0, 0, 8)
Title.BackgroundTransparency = 1
Title.Text = "🎲 AUTO DICE"
Title.TextColor3 = Color3.fromRGB(220, 220, 255)
Title.TextSize = 14
Title.Font = Enum.Font.GothamBold
Title.Parent = Frame

local StatusLabel = Instance.new("TextLabel")
StatusLabel.Size = UDim2.new(1, 0, 0, 20)
StatusLabel.Position = UDim2.new(0, 0, 0, 36)
StatusLabel.BackgroundTransparency = 1
StatusLabel.Text = "Dice: OFF"
StatusLabel.TextColor3 = Color3.fromRGB(180, 80, 80)
StatusLabel.TextSize = 12
StatusLabel.Font = Enum.Font.Gotham
StatusLabel.Parent = Frame

local Button = Instance.new("TextButton")
Button.Size = UDim2.new(0, 140, 0, 28)
Button.Position = UDim2.new(0.5, -70, 1, -38)
Button.BackgroundColor3 = Color3.fromRGB(80, 80, 200)
Button.Text = "ENABLE"
Button.TextColor3 = Color3.fromRGB(255, 255, 255)
Button.TextSize = 13
Button.Font = Enum.Font.GothamBold
Button.BorderSizePixel = 0
Button.Parent = Frame

local BtnCorner = Instance.new("UICorner")
BtnCorner.CornerRadius = UDim.new(0, 8)
BtnCorner.Parent = Button

Button.MouseButton1Click:Connect(function()
    diceEnabled = not diceEnabled
    if diceEnabled then
        Button.Text = "DISABLE"
        Button.BackgroundColor3 = Color3.fromRGB(200, 60, 60)
        Stroke.Color = Color3.fromRGB(80, 220, 120)
        StatusLabel.Text = "Dice: ON"
        StatusLabel.TextColor3 = Color3.fromRGB(80, 220, 120)
    else
        Button.Text = "ENABLE"
        Button.BackgroundColor3 = Color3.fromRGB(80, 80, 200)
        Stroke.Color = Color3.fromRGB(60, 60, 80)
        StatusLabel.Text = "Dice: OFF"
        StatusLabel.TextColor3 = Color3.fromRGB(180, 80, 80)
    end
end)

-- Auto buy potions always
task.spawn(function()
    while true do
        for _, potionName in ipairs(potionList) do
            pcall(function()
                buyEvent:InvokeServer(potionName, AMOUNT, "potion")
            end)
            task.wait(DELAY)
        end
        task.wait(1)
    end
end)

-- Auto buy dice only when enabled
task.spawn(function()
    while true do
        if diceEnabled then
            for _, diceName in ipairs(diceList) do
                if not diceEnabled then break end
                pcall(function()
                    buyEvent:InvokeServer(diceName, AMOUNT, "dice")
                end)
                task.wait(DELAY)
            end
            task.wait(1)
        else
            task.wait(0.1)
        end
    end
end)

print("Spin A Baddie UI loaded!")