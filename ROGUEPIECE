local activeTab = isRaid and "combat" or "main"
local MAX_HEIGHT = 300

local COLOR_ACTIVE_MAIN   = Color3.fromRGB(70, 130, 220)
local COLOR_ACTIVE_COMBAT = Color3.fromRGB(150, 70, 220)
local COLOR_ACTIVE_SKILLS = Color3.fromRGB(220, 150, 50)
local COLOR_INACTIVE      = Color3.fromRGB(50, 50, 50)

local function switchTab(tab)
    activeTab = tab
    mainContainer.Visible = false
    combatScroll.Visible = false
    skillsScroll.Visible = false
    if mainTabBtn then mainTabBtn.BackgroundColor3 = COLOR_INACTIVE end
    if combatTabBtn then combatTabBtn.BackgroundColor3 = COLOR_INACTIVE end
    if skillsTabBtn then skillsTabBtn.BackgroundColor3 = COLOR_INACTIVE end
    if tab == "main" then
        mainContainer.Visible = true
        if mainTabBtn then mainTabBtn.BackgroundColor3 = COLOR_ACTIVE_MAIN end
    elseif tab == "combat" then
        combatScroll.Visible = true
        if combatTabBtn then combatTabBtn.BackgroundColor3 = COLOR_ACTIVE_COMBAT end
    elseif tab == "skills" then
        skillsScroll.Visible = true
        if skillsTabBtn then skillsTabBtn.BackgroundColor3 = COLOR_ACTIVE_SKILLS end
    end
end

if isMainGame then
    switchTab("main")
    mainTabBtn.MouseButton1Click:Connect(function() switchTab("main") end)
    combatTabBtn.MouseButton1Click:Connect(function() switchTab("combat") end)
    skillsTabBtn.MouseButton1Click:Connect(function() switchTab("skills") end)
else
    switchTab("combat")
    combatTabBtn.MouseButton1Click:Connect(function() switchTab("combat") end)
    skillsTabBtn.MouseButton1Click:Connect(function() switchTab("skills") end)
end

