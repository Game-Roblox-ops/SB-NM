-- Logic
local clicking = false
local clickThread

local function getCPS()
    local n = tonumber(speedBox.Text)
    if not n or n < 1 then return 1 end
    if n > 1000 then return 1000 end
    return n
end

local function startClicking()
    if clickThread then return end
    clickThread = task.spawn(function()
        while clicking do
            local cps = getCPS()
            local pos = target.AbsolutePosition + (target.AbsoluteSize / 2)
            local x = math.floor(pos.X)
            local y = math.floor(pos.Y)
            VirtualInputManager:SendMouseButtonEvent(x, y, 0, true, game, 0)
            VirtualInputManager:SendMouseButtonEvent(x, y, 0, false, game, 0)
            task.wait(1 / cps)
        end
    end)
end

local function stopClicking()
    clicking = false
    clickThread = nil
end

toggleButton.MouseButton1Click:Connect(function()
    clicking = not clicking
    if clicking then
        toggleButton.Text = "DISABLE"
        statusLabel.Text = "Status: ON"
        statusLabel.TextColor3 = Color3.fromRGB(80, 220, 120)
        TweenService:Create(toggleButton, TweenInfo.new(0.2), {BackgroundColor3 = Color3.fromRGB(200, 60, 60)}):Play()
        TweenService:Create(stroke, TweenInfo.new(0.2), {Color = Color3.fromRGB(80, 220, 120)}):Play()
        startClicking()
    else
        toggleButton.Text = "ENABLE"
        statusLabel.Text = "Status: OFF"
        statusLabel.TextColor3 = Color3.fromRGB(180, 80, 80)
        TweenService:Create(toggleButton, TweenInfo.new(0.2), {BackgroundColor3 = Color3.fromRGB(80, 80, 200)}):Play()
        TweenService:Create(stroke, TweenInfo.new(0.2), {Color = Color3.fromRGB(60, 60, 80)}):Play()
        stopClicking()
    end
end)

